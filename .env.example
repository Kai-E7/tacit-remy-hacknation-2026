# Copy only the variables required by the selected application stack into a
# local environment file. Never commit real credentials.
APP_ENV=development
APP_NAME=hacknation-03102026
LOG_LEVEL=info
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000

# Server only. Never use NEXT_PUBLIC_ for provider secrets.
# Voice starts only on explicit user action. Development enables it with these keys.
# Production requires VOICE_ENABLED=true and an HTTPS PUBLIC_BASE_URL.
VOICE_ENABLED=
ELEVENLABS_API_KEY=
ELEVENLABS_INTERVIEWER_AGENT_ID=
ELEVENLABS_TUTOR_AGENT_ID=
ANTHROPIC_API_KEY=
# Local development defaults on. Production requires LEARNING_ENABLED=true
# and the exact HTTPS PUBLIC_BASE_URL. Public-demo requests are rate-limited;
# this is not user-by-user data isolation.
LEARNING_ENABLED=
# Verify availability in your account before the first live test.
ANTHROPIC_VISION_MODEL=claude-sonnet-5-5
ANTHROPIC_MAP_MODEL=claude-sonnet-5-5
ANTHROPIC_LIVE_MAP_MODEL=claude-sonnet-5-5
# Private Presidio text and OCR-span service. Selected image frames also need
# Tesseract in the app container. Missing/unavailable service => image withheld,
# explicit text fallback/manual review, no onward Claude request. Never NEXT_PUBLIC_.
PRESIDIO_URL=
PRESIDIO_TOKEN=
SUPABASE_URL=
# Prefer a new server-only sb_secret key; the legacy service-role JWT also works.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# The public demo has no password. Old DEMO_GATE_ENABLED, DEMO_PASSWORD and
# SESSION_SIGNING_SECRET deployment variables are ignored and can be removed.
# Sliplane deployment credentials belong in local tooling, not the app container.

# Optional timing decision provider via OpenRouter. Adding a key alone does not enable API calls.
OPENROUTER_API_KEY=
# Backward-compatible local name; prefer OPENROUTER_API_KEY for new setups.
TYPESAFE_API_KEY=
JEV_MODEL=typesafe/jev-1.13
INTERRUPTION_DECISION_PROVIDER=rules
